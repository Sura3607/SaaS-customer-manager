.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Build outputs
dist/
build/

# Docker volumes
data/

# AWS credentials (nếu có local config)
.aws/

# Terraform state (nếu dùng IaC)
*.tfstate
*.tfstate.backup
.terraform/
