# ============================
# Server Configuration
# ============================
NODE_ENV=development
PORT=5000
LOG_LEVEL=debug
FRONTEND_URL=http://localhost:5173

# ============================
# Database (MySQL via Prisma)
# ============================
DATABASE_URL=mysql://user:password@localhost:3306/saas_db

# ============================
# JWT Authentication
# ============================
JWT_SECRET=your-super-secret-jwt-key-min-32-chars
JWT_EXPIRE=15m
JWT_REFRESH_EXPIRE=7d

# ============================
# SpeedSMS Configuration
# ============================
SPEEDSMS_API_TOKEN=your_access_token_here

# ============================
# SendGrid Email Configuration
# ============================
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxx
SENDGRID_WEBHOOK_VERIFICATION_KEY=your_verification_key_here
SENDGRID_FROM_EMAIL=noreply@saas.example.com

# ============================
# Rate Limiting
# ============================
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX_REQUESTS=100
